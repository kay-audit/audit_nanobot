```
# Logs and temp files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Dependency directories
node_modules/
venv/
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/
dist/
build/
target/
.gradle/

# System files
.DS_Store
Thumbs.db

# Local secrets (managed by .secrets.env + scripts/render-env.ps1)
.secrets.env

# Per-feature project.json backups (created by feature_bridge applier;
# restore from git history if needed, not from these runtime artefacts)
project.json.bak-*

# One-off debug scripts (start with _check_); should not be tracked
tests/_check_*.py

# Local memory and session state (IDE/runtime artefacts, not source-of-truth)
workspace/memory/
workspace/sessions/

# Coverage reports
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```