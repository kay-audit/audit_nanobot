# Настройки без секретов. Ключ вводится только через терминал.
LLM_WIKI_PROVIDER=minimax
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT=60
MINIMAX_MAX_ATTEMPTS=3
MINIMAX_MAX_TOKENS=8192
LLM_WIKI_ALLOW_EXTERNAL_CONTEXT=true
LLM_WIKI_QUERY_SEARCH=faiss
# BGE-M3 ищется локально в проекте и HF-кэше. Для своей папки:
# LLM_WIKI_EMBEDDING_MODEL=/полный/путь/к/bge-m3
LLM_WIKI_ALLOW_EMBEDDING_DOWNLOAD=false
LLM_WIKI_EMBEDDING_DEVICE=auto
LLM_WIKI_FAISS_TOP_K=4
LLM_WIKI_FAISS_MIN_SCORE=0.15
LLM_WIKI_MAX_FILE_CHARS=500000
LLM_WIKI_MAX_CONTEXT_CHARS=120000
LLM_WIKI_MAX_QUERY_PAGES=6
LLM_WIKI_MAX_HOPS=3
